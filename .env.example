# Copy this file to ".env" and fill in your keys. NEVER commit .env (it is gitignored).
OPENAI_API_KEY=
TAVILY_API_KEY=

# ---- Optional overrides (sensible defaults are used if unset) ----
# Run the whole pipeline with deterministic fakes, no API keys needed:
# PIPELINE_MOCK=1
#
# Models (cost-aware): a stronger model for writing/editing, a cheaper one for graders.
# MODEL_STRONG=gpt-4.1
# MODEL_MINI=gpt-4.1-mini
#
# Quality thresholds + loop guard:
# FACT_CHECK_THRESHOLD=0.85
# SEO_THRESHOLD=70
# MAX_REVISIONS=3

# ===================== V2 =====================
# Persistent vector memory (ChromaDB)
CHROMA_PERSIST_DIR=./memory/chroma_store
# FastAPI backend port + frontend API base URL
V2_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Optional V2 model overrides (default to the gpt-4.1 family above):
# OUTLINE_MODEL=gpt-4.1-mini
# RESEARCH_MODEL=gpt-4.1-mini
# WRITER_MODEL=gpt-4.1
# EDITOR_MODEL=gpt-4.1
# FACTCHECK_MODEL=gpt-4.1-mini
# SEO_MODEL=gpt-4.1-mini
# EMBED_MODEL=text-embedding-3-small
# WHISPER_MODEL=whisper-1
# TTS_MODEL=tts-1
# Memory / loop / batch tuning:
# MEMORY_SIMILARITY_THRESHOLD=0.82
# EDIT_DISTANCE_STALL=0.03
# MAX_PARALLEL_SUBGRAPHS=3
